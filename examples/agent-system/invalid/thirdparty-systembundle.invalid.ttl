@prefix agentsys: <https://spec.sourceos.dev/vocab/agent-system#> .
@prefix ex: <https://spec.sourceos.dev/vocab/agent-system/examples#> .
ex:badTP a agentsys:ThirdPartyAgent ;
  agentsys:bundleId "com.evil.app" ; agentsys:agentClass "third_party" ; agentsys:interruptLevel "standard" ;
  agentsys:suppressUserAuthorizationPrompt false ; agentsys:systemBundle true .
