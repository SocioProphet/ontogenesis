@prefix agentsys: <https://spec.sourceos.dev/vocab/agent-system#> .
@prefix ex: <https://spec.sourceos.dev/vocab/agent-system/examples#> .
ex:badSC a agentsys:SystemCoreAgent ;
  agentsys:bundleId "com.apple.fakecore" ; agentsys:agentClass "system_core" ; agentsys:interruptLevel "critical" ;
  agentsys:suppressUserAuthorizationPrompt true ; agentsys:isDaemon true ;
  agentsys:isAppleSigned false .
