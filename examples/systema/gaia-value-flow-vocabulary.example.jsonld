          "sourceKind": "world_model_binding_contract",
          "extractionConfidence": "C",
          "reviewState": "candidate",
          "quoteBoundary": "operational_translation",
          "uncertaintyNote": "Governed replacement for the bare enum/field 'carrying_capacity' in gaia-world-model PR #41 (value-flow subsystem, OPEN). It MUST resolve as a read of the GAIA WorldModelSubstrate W biosphere/resource state, not a free parameter. Candidate until PR #41 merges."
        }
      ],
      "definition": [
        {
          "@id": "systema:definition:carrying-capacity:v0-1",
          "@type": "ConceptDefinition",
          "definitionText": "The world-model biosphere/resource carrying capacity that bounds sustainable value flow; a world-state quantity read from WorldModelSubstrate W.",
          "claimLevel": "operational_definition"
        }
      ],
      "operationalDefinition": "The value_flow_binding.carrying_capacity field must be a pinned read of the gaia world-model substrate, grounding renewable base and the carrying-capacity discount.",
