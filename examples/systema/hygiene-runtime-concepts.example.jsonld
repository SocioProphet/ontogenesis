      "definition": [
        {
          "@id": "systema:definition:bias-passport:v0-1",
          "@type": "ConceptDefinition",
          "definitionText": "A sealed HygieneRunArtifact (hygiene_profile=bias-passport) whose findings each carry a governed COGBIAS/LOGFALL detector id in the reconciled namespace.",
          "claimLevel": "conformance_rule"
        }
      ],
      "operationalDefinition": "The credential a Truth Record consumes for the per-participant bias state; each detection names a governed id or is rejected before emission.",
      "allowedUse": [
        "governed bias credential feeding a Truth Record",
        "hygiene-layer bias reporting"
      ],
      "forbiddenUse": [
        "load-bearing quotation without review",
        "analogy as proof",
        "unowned duplicate definition across repos"
