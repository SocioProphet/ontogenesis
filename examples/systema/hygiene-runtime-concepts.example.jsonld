      ],
      "definition": [
        {
          "@id": "systema:definition:detector-id-map:v0-1",
          "@type": "ConceptDefinition",
          "definitionText": "A governed bijection binding each detector id the runtime emits (Noetica 0.1.0) to its canonical standard id, with a succeeds_into migration ladder.",
          "claimLevel": "conformance_rule"
        }
      ],
      "operationalDefinition": "The allow-list a producer enforces: an emitted id absent from the map is rejected; standard_id is emitted, never the V2 successor.",
      "allowedUse": [
        "reconciling emitted ids to governed standard ids",
        "rejecting drifted/ungoverned detector ids"
      ],
      "forbiddenUse": [
        "load-bearing quotation without review",
        "analogy as proof",
