      "conceptId": "systema:concept:ctest-run",
      "skos:prefLabel": "Counter-Test Run",
      "skos:altLabel": [
        "CTEST run",
        "Test-Obligation run"
      ],
      "sourceAnchor": [
        {
          "@id": "systema:source-anchor:ctest-run:v0-1",
          "@type": "SourceAnchor",
          "sourceRef": "SocioProphet/agentplane#331:tools/hygiene_runtime.py",
          "sourceKind": "open_pr_contract",
          "extractionConfidence": "B",
          "reviewState": "manually_reviewed",
          "quoteBoundary": "operational_translation",
          "uncertaintyNote": "Introduced by the CTEST runner; run_ctest() emits a CountertestRunArtifact. Anchored to the open PR."
        }
      ],
      "definition": [
        {
          "@id": "systema:definition:ctest-run:v0-1",
          "@type": "ConceptDefinition",
          "definitionText": "A CountertestRunArtifact recording, per claim, whether a declared counter-test admits, refutes, or finds the claim epistemically_void.",
          "claimLevel": "conformance_rule"
        }
      ],
      "operationalDefinition": "The runtime realization of the Truth Engine's Test-Obligation (Crown T1): a claim with no counter-test is epistemically_void; affirming-the-consequent is rejected (Crown D1).",
      "allowedUse": [
        "realizing the Test-Obligation for a claim",
        "admitting or voiding a claim under counter-test"
      ],
      "forbiddenUse": [
        "load-bearing quotation without review",
        "analogy as proof",
        "unowned duplicate definition across repos"
      ],
      "implementationSurface": [
        {
          "@id": "systema:surface:ctest-run",
          "@type": "ImplementationSurface",
          "ownerRepo": "SocioProphet/agentplane",
          "surfacePath": "tools/hygiene_runtime.py"
        }
      ],
      "evidenceRequirement": [
        {
          "@id": "systema:evidence-requirement:ctest-run",
          "@type": "EvidenceRequirement",
          "evidenceRequirementText": "Must be schema-conformant; an unfalsifiable claim must be marked epistemically_void; affirming-the-consequent must carry REJECTED_AFFIRMING_THE_CONSEQUENT."
        }
      ],
