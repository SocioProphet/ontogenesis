      "@id": "systema:concept:separation-theorem",
      "@type": "ConceptEntry",
      "conceptId": "systema:concept:separation-theorem",
      "skos:prefLabel": "FTP Separation Theorem",
      "skos:altLabel": [
        "margin/funding separation",
        "cross-subsidy prohibition"
      ],
      "sourceAnchor": [
        {
          "@id": "systema:source-anchor:separation-theorem:v0-1",
          "@type": "SourceAnchor",
          "sourceRef": "SocioProphet/economic-prophet#44:schemas/ftp_separation.schema.json",
          "sourceKind": "merged_pr_contract",
          "extractionConfidence": "B",
          "reviewState": "candidate",
          "quoteBoundary": "operational_translation",
          "uncertaintyNote": "FTP-1 separation schema merged in economic-prophet #44. Learned extraction, candidate until concept-record review."
        }
      ],
      "definition": [
        {
          "@id": "systema:definition:separation-theorem:v0-1",
          "@type": "ConceptDefinition",
          "definitionText": "Business-unit margin is separable from funding and interest-rate risk once each cashflow is priced at its matched-maturity transfer rate; a cross-subsidy is a contract violation.",
          "claimLevel": "operational_definition"
        }
      ],
      "operationalDefinition": "A conformance rule: after matched-maturity transfer pricing, funding/rate risk and business margin do not leak into each other; the ftp_separation_cross_subsidy fixture is rejected.",
