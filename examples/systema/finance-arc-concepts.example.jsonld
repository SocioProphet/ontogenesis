      "definition": [
        {
          "@id": "systema:definition:ftp-matched-maturity:v0-1",
          "@type": "ConceptDefinition",
          "definitionText": "The funds-transfer-pricing rate assigned to a position by matching its maturity to the funding curve, separating business margin from funding and liquidity cost.",
          "claimLevel": "operational_definition"
        }
      ],
      "operationalDefinition": "Each cashflow is priced at the funding-curve rate for its own maturity, so the transfer rate carries funding/liquidity and the residual is business margin.",
