        {
          "@id": "systema:definition:euler-marginal-capital:v0-1",
          "@type": "ConceptDefinition",
          "definitionText": "Additive allocation of coherent portfolio capital to sub-positions via Euler's theorem on homogeneous risk measures (marginal contribution).",
          "claimLevel": "operational_definition"
        }
      ],
      "operationalDefinition": "Given a positively-homogeneous coherent risk measure, capital is allocated to each sub-position by its marginal (Euler) contribution, and the allocations sum to the total.",
