      "definition": [
        {
          "@id": "systema:definition:risk-measure-family:v0-2",
          "@type": "ConceptDefinition",
          "definitionText": "One risk(F, kernel, reference, horizon) interface over a loss distribution F that unifies Sharpe, Sortino, Kappa, lower-partial-moment (LPM), Value-at-Risk, Expected Shortfall, and spectral risk measures.",
          "claimLevel": "operational_definition"
        }
      ],
      "operationalDefinition": "A single risk interface parameterised by a kernel over a loss distribution F, with a declared reference and horizon, so all family members are one contract rather than parallel re-implementations.",
