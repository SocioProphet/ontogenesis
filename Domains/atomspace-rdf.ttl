@base <https://socioprophet.github.io/ontogenesis/> .
@prefix as:    <https://socioprophet.github.io/ontogenesis/domains/atomspace-rdf#> .
@prefix upper: <https://socioprophet.github.io/ontogenesis/upper#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .

<Domains/atomspace-rdf.ttl> a owl:Ontology ;
  dct:title "AtomSpace <-> RDF StorageNode connector (round-trip test vector)" ;
  dct:description "The AtomSpace-hypergraph -> RDF promotion, made concrete and reversible. ConceptNode/PredicateNode promote to RDF resources; NumberNode to a typed literal; InheritanceLink(A,B) and EvaluationLink(Pred, ListLink(a,b)) each promote to ONE triple; a TruthValue(strength, confidence) promotes to an RDF reified annotation on that statement (the RDF-standard reification that an RDF-star quoted-triple annotation desugars to, mirroring the #136 n-ary intermediate-node idiom). This ABox is the canonical RDF that tests/fixtures/atomspace-rdf/atomspace-graph.json maps to, and it round-trips back isomorphic including TruthValues." ;
  owl:versionInfo "0.1.0" ;
  owl:imports <Upper/upper-core.ttl> .

### TBox --- the connector's node/link/truth-value vocabulary.
as:ConceptNode a owl:Class ; rdfs:subClassOf upper:Entity ;
  rdfs:label "ConceptNode" ; rdfs:comment "An AtomSpace ConceptNode promoted to an RDF resource." .
as:PredicateNode a owl:Class ; rdfs:subClassOf upper:InformationArtifact ;
  rdfs:label "PredicateNode" ; rdfs:comment "An AtomSpace PredicateNode; its IRI is used as the predicate of the promoted EvaluationLink triple." .

# The reserved predicate for InheritanceLink (distinct from any PredicateNode).
as:inherits a owl:ObjectProperty ; rdfs:label "inherits (InheritanceLink)" ;
  rdfs:comment "InheritanceLink(A,B) promotes to the triple  A as:inherits B ." .

# A TruthValue is carried by reifying the promoted statement as an intermediate node.
as:TruthValueStatement a owl:Class ; rdfs:subClassOf rdf:Statement ;
  rdfs:label "TruthValue-annotated statement" ;
  rdfs:comment "Reifies exactly one promoted triple and carries its AtomSpace TruthValue (strength, confidence)." .
as:strength a owl:DatatypeProperty ; rdfs:domain as:TruthValueStatement ; rdfs:range xsd:decimal ; rdfs:label "strength" .
as:confidence a owl:DatatypeProperty ; rdfs:domain as:TruthValueStatement ; rdfs:range xsd:decimal ; rdfs:label "confidence" .

### ABox --- the promoted RDF for the fixture AtomSpace graph.

# Nodes.
as:concept-Alice  a as:ConceptNode .
as:concept-Human  a as:ConceptNode .
as:concept-Mammal a as:ConceptNode .
as:concept-Bob    a as:ConceptNode .
as:predicate-likes a as:PredicateNode .
as:predicate-age   a as:PredicateNode .

# Links -> triples.
as:concept-Alice as:inherits as:concept-Human .
as:concept-Human as:inherits as:concept-Mammal .
as:concept-Alice as:predicate-likes as:concept-Bob .
as:concept-Alice as:predicate-age "30"^^xsd:decimal .

# TruthValues -> reified annotations on each promoted statement.
[] a as:TruthValueStatement ;
  rdf:subject as:concept-Alice ; rdf:predicate as:inherits ; rdf:object as:concept-Human ;
  as:strength "0.9"^^xsd:decimal ; as:confidence "0.8"^^xsd:decimal .

[] a as:TruthValueStatement ;
  rdf:subject as:concept-Human ; rdf:predicate as:inherits ; rdf:object as:concept-Mammal ;
  as:strength "1.0"^^xsd:decimal ; as:confidence "0.99"^^xsd:decimal .

[] a as:TruthValueStatement ;
  rdf:subject as:concept-Alice ; rdf:predicate as:predicate-likes ; rdf:object as:concept-Bob ;
  as:strength "0.8"^^xsd:decimal ; as:confidence "0.7"^^xsd:decimal .

[] a as:TruthValueStatement ;
  rdf:subject as:concept-Alice ; rdf:predicate as:predicate-age ; rdf:object "30"^^xsd:decimal ;
  as:strength "1.0"^^xsd:decimal ; as:confidence "1.0"^^xsd:decimal .
