@base <https://socioprophet.github.io/ontogenesis/> .
@prefix agentsys: <https://spec.sourceos.dev/vocab/agent-system#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .

<Domains/agent-system/permission-flags.ttl> a owl:Ontology ;
  dct:title "Ontogenesis Domain — Agent System: Permission Flags" ;
  dct:description "Boolean permission-flag and intelligence-constraint properties for host agents." ;
  owl:versionInfo "1.0.0" ;
  owl:imports <Domains/agent-system/agent-class.ttl> .

# Annotation property for inline governance/enforcement notes.
agentsys:governanceNote a owl:AnnotationProperty ;
  rdfs:label "governance note" .

# --- Permission flags (all HostAgent, xsd:boolean) ---
agentsys:isDaemon a owl:DatatypeProperty ; rdfs:domain agentsys:HostAgent ; rdfs:range xsd:boolean ; rdfs:label "is daemon" .
agentsys:isAppleSigned a owl:DatatypeProperty ; rdfs:domain agentsys:HostAgent ; rdfs:range xsd:boolean ; rdfs:label "is apple signed" .
agentsys:suppressUserAuthorizationPrompt a owl:DatatypeProperty ; rdfs:domain agentsys:HostAgent ; rdfs:range xsd:boolean ;
  rdfs:label "suppress user authorization prompt" ;
  agentsys:governanceNote "Only valid true when isAppleSigned is true; forbidden for third_party/app_helper/legacy_bridge (SEAM-002)." .
agentsys:systemBundle a owl:DatatypeProperty ; rdfs:domain agentsys:HostAgent ; rdfs:range xsd:boolean ;
  rdfs:label "system bundle" ;
  agentsys:governanceNote "third_party must not set this true (class elevation)." .
agentsys:contentVisibility a owl:DatatypeProperty ; rdfs:domain agentsys:HostAgent ; rdfs:range xsd:string ; rdfs:label "content visibility" .

# --- Intelligence constraints (IntelligenceAutomationAgent) ---
agentsys:summarizePreviewsPermitted a owl:DatatypeProperty ; rdfs:domain agentsys:IntelligenceAutomationAgent ; rdfs:range xsd:boolean ;
  rdfs:label "summarize previews permitted" ;
  agentsys:governanceNote "Forbidden (must be false) for intelligence_automation (SEAM-009)." .
agentsys:dndIntelligentManagementPermitted a owl:DatatypeProperty ; rdfs:domain agentsys:IntelligenceAutomationAgent ; rdfs:range xsd:boolean ;
  rdfs:label "dnd intelligent management permitted" ;
  agentsys:governanceNote "Forbidden (must be false) for intelligence_automation (SEAM-009)." .
agentsys:autonomousActionPermitted a owl:DatatypeProperty ; rdfs:domain agentsys:IntelligenceAutomationAgent ; rdfs:range xsd:boolean ;
  rdfs:label "autonomous action permitted" ;
  agentsys:governanceNote "Must be explicitly declared for intelligence_automation; no human-in-loop bypass without it (SEAM-009)." .
