@base <https://socioprophet.github.io/ontogenesis/> .
@prefix srcos: <https://schemas.srcos.ai/v2/> .
@prefix srcosg: <https://schemas.srcos.ai/v2/glossary/> .
@prefix upper: <https://socioprophet.github.io/ontogenesis/upper#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .

##############################################################################
# SourceOS Glossary — the vocabulary substrate, lifted into Ontogenesis.
#
# GENERATED by scripts/ingest_srcos_glossary.py from upstream draft GlossaryTerm JSON
# (sourceos-spec tools/vocab_currency_loop.py -> result.proposedTerms). Additive, spec-first.
# Edit the generator or the upstream loop, not this file.
##############################################################################

<Platform/sourceos/glossary.ttl> a owl:Ontology ;
  dct:title "SourceOS Glossary" ;
  dct:description "Vocabulary-as-governance-substrate: SourceOS/SociOS glossary terms lifted from the sourceos-spec GlossaryTerm contract via the governed vocab-currency loop. A term regulates state only once captured (label+definition) and approved." ;
  dct:source "sourceos-spec:tools/vocab_currency_loop.py" ;
  owl:versionInfo "0.1.0" ;
  owl:imports <Upper/upper-core.ttl>, <Platform/platform.ttl> .

### TBox — a SourceOS glossary term is a SKOS concept in the governed graph.
srcos:GlossaryTerm a owl:Class ;
  rdfs:subClassOf skos:Concept, upper:InformationArtifact ;
  rdfs:label "SourceOS glossary term" ;
  rdfs:comment "A term from the sourceos-spec GlossaryTerm contract; regulates estate state once captured and approved." .

srcos:glossaryStatus a owl:DatatypeProperty ;
  rdfs:domain srcos:GlossaryTerm ; rdfs:range xsd:string ;
  rdfs:label "glossary status" ; rdfs:comment "draft | approved | deprecated (mirrors GlossaryTerm.status)." .

srcos:sourceUrn a owl:DatatypeProperty ;
  rdfs:domain srcos:GlossaryTerm ; rdfs:range xsd:string ;
  rdfs:label "upstream URN" ; rdfs:comment "The urn:srcos:glossary: id this term was ingested from (provenance)." .

### ABox — generated term instances.

srcosg:attestation a srcos:GlossaryTerm ;
  skos:prefLabel "attestation" ;
  skos:definition "A signed statement that an artifact was built and verified; its absence yields a Speculative epistemic level, never Proved." ;
  srcos:glossaryStatus "approved" ;
  srcos:sourceUrn "urn:srcos:glossary:attestation" .

srcosg:data-class a srcos:GlossaryTerm ;
  skos:prefLabel "data class" ;
  skos:definition "An ontologically-typed data-side governance node (OntoDT/OntoDQ) binding a datatype-ontology class, a business glossary term, and a valid-values domain." ;
  srcos:glossaryStatus "approved" ;
  srcos:sourceUrn "urn:srcos:glossary:data-class" .

srcosg:epistemic-level a srcos:GlossaryTerm ;
  skos:prefLabel "epistemic level" ;
  skos:definition "The MEET of attestation and verification on a receipt — Proved, Speculative, or Refuted; recomputed by the validator, never merely declared." ;
  srcos:glossaryStatus "approved" ;
  srcos:sourceUrn "urn:srcos:glossary:epistemic-level" .

srcosg:governed-loop a srcos:GlossaryTerm ;
  skos:prefLabel "governed loop" ;
  skos:definition "A correction/convergence loop admissible only when bounded, convergent, fail-closed, and admitted by the superconscious; the only place a cycle is legitimate." ;
  srcos:glossaryStatus "approved" ;
  srcos:sourceUrn "urn:srcos:glossary:governed-loop" .

srcosg:operational-dag a srcos:GlossaryTerm ;
  skos:prefLabel "operational DAG" ;
  skos:definition "The operational task graph carrying identity and dependency; it must be acyclic — a cycle is refused (a loop where a DAG belongs is unsatisfiable)." ;
  srcos:glossaryStatus "approved" ;
  srcos:sourceUrn "urn:srcos:glossary:operational-dag" .

srcosg:promote-to-platform a srcos:GlossaryTerm ;
  skos:prefLabel "promote to platform" ;
  skos:definition "Moving a catalogued dataset or document to platform scope, authorized only by an approved Data-Acquisition Request (the meet of governance and IP/legal review)." ;
  srcos:glossaryStatus "approved" ;
  srcos:sourceUrn "urn:srcos:glossary:promote-to-platform" .

srcosg:release-gate a srcos:GlossaryTerm ;
  skos:prefLabel "release gate" ;
  skos:definition "A fail-closed check a service must pass to be release-ready; a gate that cannot fail is not a gate." ;
  srcos:glossaryStatus "approved" ;
  srcos:sourceUrn "urn:srcos:glossary:release-gate" .

srcosg:vocab-currency a srcos:GlossaryTerm ;
  skos:prefLabel "vocabulary currency" ;
  skos:definition "The property that the approved glossary names what the estate actually does; measured as divergence between the fixed glossary (LSA) and the open corpus (LDA)." ;
  srcos:glossaryStatus "draft" ;
  srcos:sourceUrn "urn:srcos:glossary:vocab-currency" .
