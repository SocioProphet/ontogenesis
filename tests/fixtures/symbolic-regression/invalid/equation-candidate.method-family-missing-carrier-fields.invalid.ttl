@base <https://socioprophet.github.io/ontogenesis/> .
@prefix ex:  <https://socioprophet.github.io/ontogenesis/examples/symbolic-regression#> .
@prefix sr:  <https://socioprophet.github.io/ontogenesis/symbolic-regression#> .
@prefix mf:  <https://socioprophet.github.io/ontogenesis/method-family#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:dataset-evidence-invalid-eq-mf a sr:DatasetEvidenceRef ;
  rdfs:label "Synthetic dataset evidence reference" .

ex:fit-metric-invalid-eq-mf a sr:FitMetric ;
  sr:metricName "r_squared" ;
  sr:metricValue "0.88"^^xsd:decimal .

ex:complexity-metric-invalid-eq-mf a sr:ComplexityMetric ;
  sr:metricName "node_count" ;
  sr:metricValue "6"^^xsd:decimal .

ex:dimensional-analysis-invalid-eq-mf a sr:DimensionalAnalysisResult ;
  sr:hasUnitsStatus sr:UnitsConsistent .

# Invalid per SocioProphet/ontogenesis#128 Copilot review: this EquationCandidate
# declares a neuro-symbolic mf:hasMethodFamily (dILP-style rule-guided) but omits
# every other doctrine-required carrier-boundary field (mf:groundingStatus,
# mf:validationStatus, mf:methodOutputType, mf:explanationTraceRef,
# mf:owningAuthorityPlane). All other sr:EquationCandidateShape-required fields
# are present so this fixture fails SHACL validation specifically on the
# carrier-boundary sh:not clauses, mirroring
# sr-assertion-proposal.method-family-missing-carrier-fields.invalid.ttl.
ex:equation-candidate-method-family-missing-carrier-fields a sr:EquationCandidate ;
  rdfs:label "Invalid equation candidate: method family declared without carrier-boundary fields" ;
  sr:hasEquation "rule: high_pressure(x) :- temperature(x, t), t > threshold" ;
  sr:hasDatasetEvidence ex:dataset-evidence-invalid-eq-mf ;
  sr:hasFeatureSet [ a sr:FeatureSetRef ; rdfs:label "temperature/pressure feature set" ] ;
  sr:hasOperatorLibrary [ a sr:OperatorLibraryRef ; rdfs:label "dILP template rule library" ] ;
  sr:hasFitMetric ex:fit-metric-invalid-eq-mf ;
  sr:hasComplexityMetric ex:complexity-metric-invalid-eq-mf ;
  sr:hasDimensionalAnalysis ex:dimensional-analysis-invalid-eq-mf ;
  sr:hasPromotionStatus sr:ProposalCandidate ;
  sr:nonAuthorityDeclaration "This learned rule is a candidate only." ;
  mf:hasMethodFamily mf:RuleGuided .
