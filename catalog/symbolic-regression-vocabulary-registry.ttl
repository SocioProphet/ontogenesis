@base <https://socioprophet.github.io/ontogenesis/> .
@prefix og: <https://socioprophet.github.io/ontogenesis/og#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .

<catalog/symbolic-regression-vocabulary-registry.ttl> a owl:Ontology ;
  dct:title "Symbolic Regression Vocabulary Supplemental Registry" ;
  dct:description "Supplemental registry entry for the vocab/symbolic-regression module. Added alongside the SocioProphet/ontogenesis#126 method-family cross-reference extension, which was also the occasion to give this pre-existing vocabulary tranche a registry entry, example fixtures, invalid fixtures, and a dedicated validator for the first time." ;
  owl:versionInfo "0.2.0" .

og:SymbolicRegressionVocabulary a og:Module ;
  og:layer "vocab" ;
  og:path "vocab/symbolic-regression/sr-assertion.ttl" ;
  og:baseIRI "https://socioprophet.github.io/ontogenesis/symbolic-regression#" ;
  og:semver "0.2.0" ;
  og:status "draft" ;
  rdfs:label "Symbolic regression vocabulary" .
