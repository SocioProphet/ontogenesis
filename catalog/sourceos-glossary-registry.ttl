@base <https://socioprophet.github.io/ontogenesis/> .
@prefix og: <https://socioprophet.github.io/ontogenesis/og#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .

<catalog/sourceos-glossary-registry.ttl> a owl:Ontology ;
  dct:title "SourceOS Glossary Registry Supplement" ;
  dct:description "Registry entries for the SourceOS glossary tranche — terms ingested from the sourceos-spec GlossaryTerm contract via the governed vocab-currency loop." ;
  owl:versionInfo "0.1.0" ;
  owl:imports <catalog/registry.ttl> .

og:SourceOSGlossary a og:Module ;
  og:layer "Platform" ;
  og:path "Platform/sourceos/glossary.ttl" ;
  og:baseIRI "https://schemas.srcos.ai/v2/" ;
  og:semver "0.1.0" ;
  og:status "draft" ;
  rdfs:label "SourceOS glossary (vocabulary substrate)" .

og:SourceOSGlossaryShapes a og:Module ;
  og:layer "Shapes" ;
  og:path "shapes/sourceos/glossary.shacl.ttl" ;
  og:baseIRI "https://schemas.srcos.ai/v2/" ;
  og:semver "0.1.0" ;
  og:status "draft" ;
  rdfs:label "SourceOS glossary SHACL gate" .

og:SourceOSGlossarySeed a og:Module ;
  og:layer "Examples" ;
  og:path "examples/sourceos/glossary-seed/" ;
  og:baseIRI "https://schemas.srcos.ai/v2/" ;
  og:semver "0.1.0" ;
  og:status "draft" ;
  rdfs:label "SourceOS glossary seed (upstream draft GlossaryTerm JSON)" .
